# ==============================================================================
# LopyTech Exam Portal — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` (Next.js) or `.env` (Prisma CLI) for local
# development. Never commit `.env`, `.env.local`, or `.dev.vars` files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Runtime environment: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Neon example shown below).
# Optional in local UI/demo mode: when unset, Prisma uses an in-memory no-op mock.
# Required in production and for persistent local development / Prisma CLI.
# Institute credentials are stored in the database, never in this file.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. NextAuth Authentication (JWT Session Strategy)
# ------------------------------------------------------------------------------
# Canonical application base URL used by NextAuth callbacks (required in production)
NEXTAUTH_URL=http://localhost:3000
# Cryptographic secret used by NextAuth for JWT/session signing (openssl rand -base64 32).
# Required in production; in local development an ephemeral in-memory secret is used if unset.
NEXTAUTH_SECRET=

# ------------------------------------------------------------------------------
# 4. Super Master Configuration (Single Central Platform Account)
# ------------------------------------------------------------------------------
# Centrally configured Super Master credentials (never stored in the Tenant User table).
# Required for Super Master sign-in at /super-admin/login or /login.
# No hardcoded fallback credentials exist; missing values trigger a safe config error.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Google OAuth (Optional)
# ------------------------------------------------------------------------------
# Optional Google OAuth 2.0 credentials for NextAuth GoogleProvider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. Razorpay (Optional / Future Payment Integration)
# ------------------------------------------------------------------------------
# Not required for local development. Reserved for future B2B/B2C checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Storage (Optional Future Integration — NOT Required Now)
# ------------------------------------------------------------------------------
# Leave unset during local development. Reserved for future private document storage.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=