# ==============================================================================
# LopyTech Exam Portal — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` (Next.js) or `.env` (Prisma CLI) for local
# development. Never commit `.env`, `.env.local`, or `.dev.vars` files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
# Runtime environment: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Neon example shown below).
# Optional in local UI/demo mode: when unset, Prisma uses an in-memory no-op mock.
# Required in production and for persistent local development / Prisma CLI.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ------------------------------------------------------------------------------
# 3. NextAuth Authentication
# ------------------------------------------------------------------------------
# Canonical application base URL used by NextAuth callbacks (required in production)
NEXTAUTH_URL=http://localhost:3000
# Secret key for signing NextAuth JWTs/cookies (generate via: openssl rand -base64 32)
# Required in production; in local development an ephemeral in-memory secret is used if unset.
NEXTAUTH_SECRET=

# ------------------------------------------------------------------------------
# 4. Super Admin Configuration
# ------------------------------------------------------------------------------
# Required for Super Admin login at /super-admin/login or /login.
# There are NO hardcoded default credentials; both variables must be set explicitly.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Google OAuth (Optional / Future UI Integration)
# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 credentials for NextAuth GoogleProvider.
# Leave blank if Google Sign-In is not enabled yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. Razorpay (Optional / Future Payment Integration)
# ------------------------------------------------------------------------------
# Public publishable key (safe for browser checkout UI)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only Razorpay credentials (never expose with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Storage (Optional / Future Integration)
# ------------------------------------------------------------------------------
# Reserved for migrating local /public/uploads KYC documents to private R2 buckets.
# In future Cloudflare Workers deployment, these may be provided via Worker bindings.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=